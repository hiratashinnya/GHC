{
  "description": "PreToolUse アクセス制御ルール設定。ファイル書き込み/読み込みのパス制限とコマンド実行防止を行う。",
  "version": "1.0",
  "enabled": true,

  "write_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "protect-hook-scripts",
        "description": "Hookスクリプト設定変更は人間の確認を必要とする",
        "action": "confirm",
        "when": {
          "path_patterns": [
            ".github/hooks/config/**"
          ]
        }
      },
      {
        "id": "confirm-docs-write",
        "description": "docs/ 配下のドキュメントへの書き込み前に確認を求める",
        "action": "disabled",
        "when": {
          "path_patterns": [
            "docs/**"
          ]
        }
      },
      {
        "id": "protect-iter-approved",
        "description": "iter/ 配下への書き込み前に確認を求める",
        "action": "disabled",
        "when": {
          "path_patterns": [
            "iter/**"
          ]
        }
      },
      {
        "id": "confirm-access-control-config-write",
        "description": "access-control.json への書き込みはエージェントスコープ機能追加後に confirm に昇格予定",
        "action": "disabled",
        "when": {
          "path_patterns": [
            ".github/hooks/config/access-control.json"
          ]
        }
      }
    ]
  },

  "read_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "deny-env-files",
        "description": "環境変数ファイル（.env 系）の読み取りを禁止する",
        "action": "deny",
        "when": {
          "path_patterns": [
            "**/.env",
            "**/.env.*",
            "**/secrets/**",
            "**/.secrets/**"
          ]
        }
      }
    ]
  },

  "command_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "block-destructive-delete",
        "description": "ファイル/ディレクトリの強制削除コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\brm\\b -rf",
            "\\brm\\b -fr",
            "\\brm\\b\\s",
            "\\brmdir\\b\\s",
            "\\bdel\\b\\s",
            "\\berase\\b\\s",
            "\\brd\\b /s /q",
            "\\brd\\b\\s",
            "\\bRemove-Item\\b -Recurse -Force",
            "\\bRemove-Item\\b\\s",
            "\\bri\\b\\s",
            "\\bdd\\b"
          ]
        }
      },
      {
        "id": "block-disk-format",
        "description": "ディスクフォーマットコマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "format ",
            "\\bdiskpart\\b"
          ]
        }
      },
      {
        "id": "deny-git-force-push",
        "description": "Git の push / clone 操作をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bgit\\b\\s+push\\b\\s",
            "\\bgit\\b\\s+push\\b\\s+--force(?:\\s|$)",
            "\\bgit\\b\\s+push\\b\\s+-f(?:\\s|$)",
            "\\bgit\\b\\s+clone\\b"
          ]
        }
      },
      {
        "id": "deny-git-reset-hard",
        "description": "git reset --hard をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bgit\\b\\s+reset\\b\\s+--hard(?:\\s|$)"
          ]
        }
      },
      {
        "id": "deny-git-dangerous-options",
        "description": "Git の危険オプションをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bgit\\b\\s+log\\b[^\\n]*--output(?:=|\\s)",
            "\\bgit\\b\\s+branch\\b\\s+-d(?:\\s|$)",
            "\\bgit\\b\\s+branch\\b\\s+-D(?:\\s|$)",
            "\\bgit\\b\\s+branch\\b\\s+-m(?:\\s|$)",
            "\\bgit\\b\\s+branch\\b\\s+-M(?:\\s|$)",
            "\\bgit\\b\\s+branch\\b\\s+--delete(?:\\s|$)",
            "\\bgit\\b\\s+branch\\b\\s+--force(?:\\s|$)"
          ]
        }
      },
      {
        "id": "deny-process-control-commands",
        "description": "プロセス制御系コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bkill\\b\\s",
            "\\bStop-Process\\b",
            "\\bspps\\b",
            "\\btaskkill\\b",
            "\\btaskkill\\.exe\\b",
            "\\bps\\b\\s",
            "\\btop\\b\\s"
          ]
        }
      },
      {
        "id": "deny-network-fetch-commands",
        "description": "外部通信・取得系コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bcurl\\b\\s",
            "\\bwget\\b\\s",
            "\\bInvoke-RestMethod\\b",
            "\\bInvoke-WebRequest\\b",
            "\\birm\\b\\s",
            "\\biwr\\b\\s"
          ]
        }
      },
      {
        "id": "deny-permission-and-property-changes",
        "description": "権限・属性変更コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bchmod\\b\\s",
            "\\bchown\\b\\s",
            "\\bSet-ItemProperty\\b",
            "\\bSet-Acl\\b",
            "\\bsp\\b\\s"
          ]
        }
      },
      {
        "id": "deny-expression-execution",
        "description": "任意式実行・高リスクパイプ処理をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\beval\\b\\s",
            "\\bInvoke-Expression\\b",
            "\\biex\\b\\s",
            "\\bxargs\\b",
            "\\bjq\\b\\s"
          ]
        }
      },
      {
        "id": "deny-package-install",
        "description": "外部パッケージのインストールコマンド（PowerShell/Linux/各種PM）をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bpip\\b\\s+install\\b",
            "\\bpip3\\b\\s+install\\b",
            "\\bconda\\b\\s+install\\b",
            "\\bpoetry\\b\\s+add\\b",
            "\\bpipenv\\b\\s+install\\b",
            "\\bpipx\\b\\s+install\\b",
            "\\bInstall-Module\\b",
            "\\bInstall-Package\\b",
            "\\bwinget\\b\\s+install\\b",
            "\\bchoco\\b\\s+install\\b",
            "\\bscoop\\b\\s+install\\b",
            "\\bapt\\b\\s+install\\b",
            "\\bapt-get\\b\\s+install\\b",
            "\\byum\\b\\s+install\\b",
            "\\bdnf\\b\\s+install\\b",
            "\\bpacman\\b\\s+-S(?:\\s|$)",
            "\\bzypper\\b\\s+install\\b",
            "\\bapk\\b\\s+add\\b",
            "\\bbrew\\b\\s+install\\b",
            "\\bsnap\\b\\s+install\\b",
            "\\bnpm\\b\\s+install\\b",
            "\\byarn\\b\\s+add\\b",
            "\\bpnpm\\b\\s+add\\b"
          ]
        }
      },
      {
        "id": "deny-dangerous-tool-options",
        "description": "コマンドの危険オプションをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "\\bcolumn\\b\\s+-c(?:\\s|$)",
            "\\bdate\\b\\s+-s(?:\\s|$)",
            "\\bdate\\b\\s+--set(?:\\s|$)",
            "\\bfind\\b\\s+-delete(?:\\s|$)",
            " -delete",
            " -exec",
            " -execdir",
            " -fprint",
            " -fprintf",
            " -fls",
            " -ok ",
            " -okdir",
            "\\brg\\b\\s+--pre(?:\\s|$)",
            "\\brg\\b\\s+--hostname-bin(?:\\s|$)",
            "\\bsed\\b\\s+-e(?:\\s|$)",
            "\\bsed\\b\\s+-f(?:\\s|$)",
            "\\bsed\\b\\s+--expression(?:\\s|$)",
            "\\bsed\\b\\s+--file(?:\\s|$)",
            "\\bsed\\b\\s+s/",
            ";W",
            "\\bsort\\b\\s+-o(?:\\s|$)",
            "\\bsort\\b\\s+-S(?:\\s|$)",
            "\\btree\\b\\s+-o(?:\\s|$)"
          ]
        }
      }
    ]
  }
}