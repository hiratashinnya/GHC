{
  "description": "PreToolUse アクセス制御ルール設定。ファイル書き込み/読み込みのパス制限とコマンド実行防止を行う。",
  "version": "1.0",
  "enabled": true,

  "write_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "protect-hook-scripts",
        "description": "Hookスクリプト設定変更は人間の確認を必要とする",
        "action": "confirm",
        "when": {
          "path_patterns": [
            ".github/hooks/config/**"
          ]
        }
      },
      {
        "id": "confirm-docs-write",
        "description": "docs/ 配下のドキュメントへの書き込み前に確認を求める",
        "action": "disabled",
        "when": {
          "path_patterns": [
            "docs/**"
          ]
        }
      },
      {
        "id": "protect-iter-approved",
        "description": "iter/ 配下への書き込み前に確認を求める",
        "action": "disabled",
        "when": {
          "path_patterns": [
            "iter/**"
          ]
        }
      },
      {
        "id": "confirm-access-control-config-write",
        "description": "access-control.json への書き込みはエージェントスコープ機能追加後に confirm に昇格予定",
        "action": "disabled",
        "when": {
          "path_patterns": [
            ".github/hooks/config/access-control.json"
          ]
        }
      }
    ]
  },

  "read_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "deny-env-files",
        "description": "環境変数ファイル（.env 系）の読み取りを禁止する",
        "action": "deny",
        "when": {
          "path_patterns": [
            "**/.env",
            "**/.env.*",
            "**/secrets/**",
            "**/.secrets/**"
          ]
        }
      }
    ]
  },

  "command_rules": {
    "enabled": true,
    "rules": [
      {
        "id": "block-destructive-delete",
        "description": "ファイル/ディレクトリの強制削除コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "rm -rf",
            "rm -fr",
            "rm ",
            "rmdir ",
            "del ",
            "erase ",
            "rd /s /q",
            "rd ",
            "Remove-Item -Recurse -Force",
            "Remove-Item ",
            "ri ",
            "dd "
          ]
        }
      },
      {
        "id": "block-disk-format",
        "description": "ディスクフォーマットコマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "format ",
            "diskpart"
          ]
        }
      },
      {
        "id": "deny-git-force-push",
        "description": "Git の push / clone 操作をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "git push ",
            "git push --force",
            "git push -f ",
            "git clone"
          ]
        }
      },
      {
        "id": "deny-git-reset-hard",
        "description": "git reset --hard をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "git reset --hard"
          ]
        }
      },
      {
        "id": "deny-git-dangerous-options",
        "description": "Git の危険オプションをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "git log --output",
            "--output=",
            "git branch -d",
            "git branch -D",
            "git branch -m",
            "git branch -M",
            "git branch --delete",
            "git branch --force"
          ]
        }
      },
      {
        "id": "deny-process-control-commands",
        "description": "プロセス制御系コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "kill ",
            "Stop-Process",
            "spps",
            "taskkill",
            "taskkill.exe",
            "ps ",
            "top "
          ]
        }
      },
      {
        "id": "deny-network-fetch-commands",
        "description": "外部通信・取得系コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "curl ",
            "wget ",
            "Invoke-RestMethod",
            "Invoke-WebRequest",
            "irm ",
            "iwr "
          ]
        }
      },
      {
        "id": "deny-permission-and-property-changes",
        "description": "権限・属性変更コマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "chmod ",
            "chown ",
            "Set-ItemProperty",
            "Set-Acl",
            "sp "
          ]
        }
      },
      {
        "id": "deny-expression-execution",
        "description": "任意式実行・高リスクパイプ処理をブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "eval ",
            "Invoke-Expression",
            "iex ",
            "xargs",
            "jq "
          ]
        }
      },
      {
        "id": "deny-package-install",
        "description": "外部パッケージのインストールコマンドをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "pip install",
            "pip3 install",
            "conda install",
            "poetry add",
            "pipenv install",
            "pipx install"
          ]
        }
      },
      {
        "id": "deny-dangerous-tool-options",
        "description": "コマンドの危険オプションをブロックする",
        "action": "deny",
        "when": {
          "command_patterns": [
            "column -c ",
            "date -s",
            "date --set",
            "find -delete",
            " -delete",
            " -exec",
            " -execdir",
            " -fprint",
            " -fprintf",
            " -fls",
            " -ok ",
            " -okdir",
            "rg --pre",
            "rg --hostname-bin",
            "sed -e",
            "sed -f",
            "sed --expression",
            "sed --file",
            "sed s/",
            ";W",
            "sort -o",
            "sort -S",
            "tree -o"
          ]
        }
      }
    ]
  }
}